    "app/policies/project_policy.rb": {
      "source": [
        "class ProjectPolicy < ApplicationPolicy",
        "  class Scope < Scope",
        "    def resolve",
        "      if user.admin?",
        "        scope.all",
        "      elsif user.manager?",
        "        scope.left_joins(:project_memberships)",
        "             .where(",
        "               \"projects.creator_id = :id OR project_memberships.user_id = :id\",",
        "               id: user.id",
        "             ).distinct",
        "      else",
        "        scope.joins(:project_memberships)",
        "             .where(project_memberships: { user_id: user.id })",
        "      end",
        "    end",
        "  end",
        "",
        "  def index?",
        "    true",
        "  end",
        "",
        "  def show?",
        "    user.admin? ||",
        "      record.creator == user ||",
        "      record.project_memberships.exists?(user: user)",
        "  end",
        "",
        "  def create?",
        "    return false unless user",
        "",
        "    user.admin? || user.manager?",
        "  end",
        "",
        "  def new?",
        "    create?",
        "  end",
        "  def update?",
        "    user.admin? || record.creator == user || project_manager?",
        "  end",
        "",
        "  def edit?",
        "    update?",
        "  end",
        "",
        "  def destroy?",
        "    update?",
        "  end",
        "",
        "  private",
        "",
        "  def project_manager?",
        "    record.project_memberships.exists?(user: user, role: :manager)",
        "  end",
        "end"
      ],
