      "source": [
        "class ProjectMembershipsController < ApplicationController",
        "  before_action :authenticate_user!",
        "  before_action :set_project",
        "  before_action :set_membership, only: :destroy",
        "",
        "  def create",
        "    membership = @project.project_memberships.new(membership_params)",
        "    authorize membership",
        "",
        "    if membership.save",
        "      redirect_back fallback_location: @project, notice: \"Member invited successfully.\"",
        "    else",
        "      redirect_back fallback_location: @project, alert: membership.errors.full_messages.to_sentence",
        "    end",
        "  end",
        "",
        "  def destroy",
        "    authorize @membership",
        "",
        "    if @membership.destroy",
        "      redirect_back fallback_location: @project, notice: \"Member removed successfully.\"",
        "    else",
        "      redirect_back fallback_location: @project, alert: @membership.errors.full_messages.to_sentence",
        "    end",
        "  end",
        "",
        "  private",
        "",
        "  def set_project",
        "    @project = Project.find(params[:project_id])",
        "  end",
        "",
        "  def set_membership",
        "    @membership = @project.project_memberships.find(params[:id])",
        "  end",
        "",
        "  def membership_params",
        "    membership = @project.project_memberships.new",
        "    params.require(:project_membership).permit(policy(membership).permitted_attributes)",
        "  end",
        "end"
      ],
