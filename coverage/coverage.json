      "source": [
        "class DashboardController < ApplicationController",
        "  before_action :authenticate_user!",
        "",
        "  def index",
        "    @projects = policy_scope(Project).includes(:users, :tasks)",
        "    assigned_tasks = policy_scope(Task).assigned_to(current_user)",
        "",
        "    @pending_tasks_count = assigned_tasks.where.not(status: :done).count",
        "    @done_tasks_count = assigned_tasks.done.count",
        "    @assigned_tasks = assigned_tasks.includes(:project, :assignee)",
        "",
        "    if params[:status].present? && Task.statuses.keys.include?(params[:status])",
        "      @assigned_tasks = @assigned_tasks.where(status: params[:status])",
        "    end",
        "  end",
        "end"
      ],
