    "app/policies/task_policy.rb": {
      "source": [
        "class TaskPolicy < ApplicationPolicy",
        "  class Scope < Scope",
        "    def resolve",
        "      if user.admin?",
        "        scope.all",
        "      else",
        "        scope.joins(:project).left_joins(project: :project_memberships)",
        "             .where(\"projects.creator_id = :id OR project_memberships.user_id = :id\", id: user.id)",
        "             .distinct",
        "      end",
        "    end",
        "  end",
        "",
        "  def index?",
        "    record.is_a?(Project) && ProjectPolicy.new(user, record).show?",
        "  end",
        "",
        "  def show?",
        "    user.admin? ||",
        "      record.project.creator == user ||",
        "      record.project.project_memberships.exists?(user: user)",
        "  end",
        "",
        "  def create?",
        "    return false unless user",
        "    user.admin? ||",
        "      record.project.creator == user ||",
        "      record.project.project_memberships.exists?(user: user, role: :manager)",
        "  end",
        "",
        "  def new?",
        "    create?",
        "  end",
        "",
        "  def update?",
        "    return false unless user",
        "    user.admin? ||",
        "      record.project.creator == user ||",
        "      record.project.project_memberships.exists?(user: user, role: :manager) ||",
        "      record.assignee == user",
        "  end",
        "",
        "  def edit?",
        "    update?",
        "  end",
        "",
        "  def destroy?",
        "    return false unless user",
        "    user.admin? ||",
        "      record.project.creator == user ||",
        "      record.project.project_memberships.exists?(user: user, role: :manager)",
        "  end",
        "",
        "  def permitted_attributes",
        "    if manages_tasks?",
        "      %i[title description status assignee_id]",
        "    elsif record.assignee == user",
        "      [ :status ]",
        "    else",
        "      []",
        "    end",
        "  end",
        "",
        "  private",
        "",
        "  def manages_tasks?",
        "    user.admin? ||",
        "      record.project.creator == user ||",
        "      record.project.project_memberships.exists?(user: user, role: :manager)",
        "  end",
        "end"
      ],
