        "              with: /\\A(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^A-Za-z0-9]).{8,128}\\z/,",
        "              message: \"must include uppercase, lowercase, number, and special character\"",
        "            },",
        "            allow_nil: true",
        "end"
