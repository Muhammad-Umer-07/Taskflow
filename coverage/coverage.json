      "source": [
        "class ProjectMembership < ApplicationRecord",
        "  belongs_to :user",
        "  belongs_to :project",
        "",
        "  enum :role, {",
        "    manager: 0,",
        "    member: 1",
        "  }, validate: true",
        "",
        "  validates :user_id, uniqueness: {",
        "    scope: :project_id,",
        "    message: \"is already a member of this project\"",
        "  }",
        "  validate :user_must_not_be_admin",
        "",
        "  before_destroy :prevent_creator_removal",
        "",
        "  private",
        "",
        "  def prevent_creator_removal",
        "    return unless user_id == project.creator_id",
        "",
        "    errors.add(:base, \"Project creator cannot be removed\")",
        "    throw :abort",
        "  end",
        "",
        "  def user_must_not_be_admin",
        "    errors.add(:user, \"cannot be an administrator\") if user&.admin?",
        "  end",
        "end"
      ],
